# Production env template. Copy to .env.production and fill in secrets.

# Postgres
POSTGRES_USER=cosmika
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cosmika
DATABASE_POOL_SIZE=10

# Cosmika api
WIDGET_JWT_SECRET=change-me-min-16-chars
# Encryption at rest for channel credentials (WhatsApp access token, app
# secret, webhook verify token). REQUIRED in production: 32 random bytes in
# base64, i.e. a 44-character value.
#   openssl rand -base64 32
# Deploy order: put the key in the environment and recreate the API FIRST,
# then ship the code, then convert the stored values:
#   docker exec -w /workspace/apps/api <api> node dist/scripts/channel-secrets.js --dry-run
#   docker exec -w /workspace/apps/api <api> node dist/scripts/channel-secrets.js
# Rolling back to an image that predates encryption? Put the values back
# first, or the old code cannot read them:
#   docker exec -w /workspace/apps/api <api> node dist/scripts/channel-secrets.js --decrypt
# Losing this key means losing every stored channel credential: they have to
# be re-entered from Meta. Back it up wherever the other secrets live.
COSMIKA_SECRETS_KEY=
SESSION_TTL_DAYS=30
CORS_ORIGIN=https://app.example.com
API_PUBLIC_URL=https://api.example.com
# Peers allowed to set the client IP via X-Forwarded-For. Empty = loopback
# plus the container's Docker gateway (right for Caddy on the host). A
# comma list of IPs/CIDRs overrides it; 0 trusts nobody.
COSMIKA_TRUST_PROXY=

# AI orchestrator. Set ANTHROPIC_API_KEY for real calls, or
# COSMIKA_AI_STUB=1 for the deterministic test stub.
ANTHROPIC_API_KEY=
COSMIKA_AI_STUB=0
# Optional: route Anthropic calls through a gateway (LiteLLM, OpenRouter,
# a platform gateway). Leave empty to call api.anthropic.com directly.
ANTHROPIC_BASE_URL=

# OpenAI key: KB article embeddings (text-embedding-3-small; search falls
# back to ILIKE when absent) and agents set to a gpt-* model.
OPENAI_API_KEY=
# Optional gateway for the OpenAI calls; defaults to https://api.openai.com/v1
OPENAI_BASE_URL=

# OpenRouter key, only for agents set to a `vendor/model` id (plan B models).
# Calls are restricted to zero-retention endpoints.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Public URL of the web app — used by CSAT to build the survey link sent
# to contacts.
PUBLIC_WEB_URL=https://app.example.com

# Transactional e-mail (Resend). EMAIL_FROM must be on a domain verified in
# your Resend account, e.g. "Acme <no-reply@acme.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Who receives "upgrade my plan" requests from accounts. Blank = recorded only.
COSMIKA_BILLING_NOTIFY_EMAIL=
# Your product name in the public API reference (default Cosmika).
COSMIKA_BRAND_NAME=
# Optional external billing API. Leave both blank to run without billing:
# signup gives no checkout link and every account has access.
COSMIKA_BILLING_API_URL=
COSMIKA_BILLING_API_SECRET=

# WhatsApp Cloud API. Set COSMIKA_WHATSAPP_STUB=1 to skip outbound HTTPS
# calls (useful for staging where you don't want to actually send messages).
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
COSMIKA_WHATSAPP_STUB=0

# WhatsApp Embedded Signup (Tech Provider app CosmoBots). Off unless 1, and
# off while any of the four Meta values is blank. docs/whatsapp-embedded-signup.md
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=0
# Accounts that see the button: ids separated by commas, or * for all. Blank = none.
WHATSAPP_EMBEDDED_SIGNUP_ACCOUNT_IDS=
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Messenger/Instagram: where to forward Meta events for Pages that are not
# Cosmika inboxes (e.g. the Nebula desk). Empty = no relay.
META_RELAY_PAGE_URL=
META_RELAY_INSTAGRAM_URL=

# Attachments. Leave S3_BUCKET unset to use the local filesystem
# (./tmp/attachments under api's CWD) — fine for staging, not for prod
# multi-replica deployments.
#
# Outbound WhatsApp media depends on this. With a bucket set, we hand Meta a
# presigned link and their servers fetch it directly. Without one — or when the
# presigned URL points somewhere the public internet can't reach (localhost, a
# private-network MinIO) — we fall back to uploading the bytes to Meta's media
# store on every send, and the file has to still be on that replica's disk.
#
# For Cloudflare R2: S3_REGION=auto and
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Our upload cap. Note Meta's own per-type ceilings are lower for rich media
# (image 5MB, video/audio 16MB, document 100MB); anything over the limit for
# its type is sent as a document instead.
ATTACHMENTS_MAX_BYTES=26214400

# Sentry (api + realtime). Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_DSN_REALTIME=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Web (public URLs the browser hits)
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_REALTIME_URL=wss://realtime.example.com/ws
NEXT_PUBLIC_SENTRY_DSN=
# Contacts your users see: the privacy line in onboarding and the billing
# contact on the subscription screen (finance falls back to support). Baked in
# at build time. Blank = the line is left out.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_FINANCE_EMAIL=
