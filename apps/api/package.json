{
  "name": "@cosmika/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:boot": "vitest run --config vitest.boot.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@cosmika/db": "workspace:*",
    "@cosmika/proto": "workspace:*",
    "@cosmika/shared": "workspace:*",
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "8",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/node": "^10.53.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cosmika/eslint-config": "workspace:*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "isolated-vm": "^5.0.4"
  }
}
