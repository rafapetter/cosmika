PORT=3110
DATABASE_URL=postgresql://cosmika:cosmika@localhost:5433/cosmika_dev?schema=public
SESSION_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3100
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
JWT_SECRET=dev-secret-change-me

# Encryption at rest for channel credentials (WhatsApp access token, app
# secret, webhook verify token). 32 random bytes in base64, i.e. a
# 44-character value: openssl rand -base64 32
#
# Left empty in local dev, the credentials are stored and read as plaintext,
# exactly as they were before encryption existed. In production the API
# refuses to boot without it. It also refuses to boot with a key of the wrong
# length, or when channels hold encrypted values and no key is configured.
COSMIKA_SECRETS_KEY=

# Attachment storage. With S3_BUCKET set, files go to S3/R2 and downloads
# redirect (302) to a presigned URL; left empty, files are written under
# ATTACHMENTS_LOCAL_DIR and served from the auth-guarded /attachments-files
# route. In S3/R2 mode the bucket also needs CORS for the web app to fetch
# attachments — see scripts/apply-r2-cors.sh.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ATTACHMENTS_MAX_BYTES=26214400
API_PUBLIC_URL=http://localhost:3110
